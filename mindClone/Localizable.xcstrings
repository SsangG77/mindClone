    },
    "기술 (Technology)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technology"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術（Technology）"
          }
        }
      }
    },
    "기술·사용자·비즈니스 세 원이 겹치는 교차점에서 최고의 결정이 나옵니다. 잡스가 애플 제품을 기획하던 방식의 핵심입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The best decisions come from the intersection of Technology, User, and Business. This is the core of how Jobs planned Apple products."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術・ユーザー・ビジネスの3つの円が重なる交差点で最高の決定が生まれます。ジョブズがApple製品を企画した方式の核心です。"
          }
        }
      }
    },
    "기한 없이 지속적으로 관리하는 영역 (건강, 재정 등)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongoing areas without deadlines (health, finance, etc.)"
