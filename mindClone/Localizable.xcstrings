    },
    "구매에 실패했습니다. 다시 시도해주세요." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchase failed. Please try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入に失敗しました。もう一度お試しください。"
          }
        }
      }
    },
    "구매완료" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchased"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入済み"
          }
        }
      }
    },
    "글과 그림을 자유롭게 섞어 기록합니다. 다빈치처럼 관찰하고, 스케치하고, 메모를 남기세요. 정형화된 틀이 없는 것이 곧 형식입니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freely mix text and drawings. Observe, sketch, and take notes like Da Vinci. Having no rigid format is the format itself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文と絵を自由に混ぜて記録します。ダ・ヴィンチのように観察し、スケッチし、メモを残しましょう。型がないことが型です。"
          }
        }
      }
    },
    "금" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fri"
